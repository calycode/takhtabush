{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "ignoreDeprecations": "6.0",
      "moduleResolution": "bundler",
      "lib": ["ES2022"],
      "noEmit": true,
      "strict": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "verbatimModuleSyntax": false,
      "forceConsistentCasingInFileNames": true
   }
}
