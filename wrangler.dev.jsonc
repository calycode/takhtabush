{
   // Local development config. Production, Appflare, and Deploy to Cloudflare
   // use the root `wrangler.jsonc`, which lets the installer provision D1/R2.
   "$schema": "node_modules/wrangler/config-schema.json",
   "name": "takhtabush-dev",
   "main": "packages/api/src/index.ts",
   "compatibility_date": "2026-07-29",
   "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
   "assets": {
      "directory": "packages/webapp/dist/client",
      "binding": "ASSETS",
      "not_found_handling": "single-page-application",
      "run_worker_first": [
         "/api/*",
         "/mcp",
         "/mcp/*",
         "/mcp-apps/*",
         "/media/*",
         "/oauth/*",
         "/.well-known/*",
      ],
   },
   "d1_databases": [
      {
         "binding": "DB",
         "database_name": "takhtabush",
         "database_id": "00000000-0000-0000-0000-000000000000",
         "migrations_dir": "migrations",
      },
   ],
   "r2_buckets": [
      {
         "binding": "MEDIA",
         "bucket_name": "takhtabush-media",
      },
   ],
   "kv_namespaces": [
      {
         "binding": "OAUTH_KV",
      },
   ],
   "ai": {
      "binding": "AI",
   },
   "send_email": [
      {
         "name": "EMAIL",
      },
   ],
   "observability": {
      "enabled": true,
   },
   "triggers": {
      "crons": ["0 3 * * *"],
   },
   "vars": {
      "APP_URL": "http://localhost:8787",
      "ENVIRONMENT": "development",
      "EMAIL_FROM": "no-reply@takhtabush.local",
      "OWNER_EMAIL": "",
      "ALLOWED_EMAILS": "",
      // Local MCP testing without a session or API key. Uses the owner account.
      // Set MCP_DEV_USER_EMAIL to test as a different existing user.
      "MCP_DEV_NO_AUTH": "true",
      "MCP_DEV_USER_EMAIL": "",
      "AI_GATEWAY_URL": "",
      "CLEF_MODEL": "@cf/meta/llama-3.1-8b-instruct",
      // Development-only default so `pnpm dev` works immediately. Production
      // gets `SESSION_SECRET` from the install form or `wrangler secret put`.
      "SESSION_SECRET": "dev-only-insecure-session-secret",
   },
}
