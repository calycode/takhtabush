{
   "name": "@caly/ui",
   "version": "0.1.0",
   "private": true,
   "license": "MIT",
   "type": "module",
   "exports": {
      "./components/*": "./src/components/*.tsx",
      "./study": "./src/study/index.ts",
      "./study/*": "./src/study/*.tsx",
      "./markdown": "./src/markdown/index.ts",
      "./markdown/*": "./src/markdown/*.tsx",
      "./styles/*": "./src/styles/*.css",
      "./hooks/*": "./src/hooks/*.ts",
      "./lib/*": "./src/lib/*.ts"
   },
   "imports": {
      "#components/*": "./src/components/*.tsx",
      "#hooks/*": "./src/hooks/*.ts",
      "#lib/*": "./src/lib/*.ts"
   },
   "scripts": {
      "check-types": "tsc --noEmit -p tsconfig.json",
      "lint": "eslint src"
   },
   "dependencies": {
      "@base-ui/react": "^1.9.0",
      "@caly/shared": "workspace:*",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "lucide-react": "^1.59.0",
      "tailwind-merge": "^3.7.0"
   },
   "peerDependencies": {
      "preact": "*"
   },
   "devDependencies": {
      "preact": "^11.0.1",
      "typescript": "^6.0.3"
   }
}
