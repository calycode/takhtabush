{
   "name": "@caly/browser-extension",
   "version": "0.2.0",
   "private": true,
   "license": "MIT",
   "type": "module",
   "scripts": {
      "dev": "wxt",
      "dev:firefox": "wxt -b firefox",
      "build": "wxt build",
      "zip": "wxt zip",
      "check-types": "wxt prepare && tsc --noEmit -p tsconfig.json",
      "lint": "eslint src",
      "test": "vitest run --passWithNoTests",
      "postinstall": "wxt prepare"
   },
   "dependencies": {
      "@caly/shared": "workspace:*"
   },
   "devDependencies": {
      "@types/node": "^26.6.5",
      "@wxt-dev/auto-icons": "^1.1.2",
      "linkedom": "^0.18.12",
      "typescript": "^6.0.3",
      "vite": "^8.3.6",
      "vitest": "^5.0.5",
      "web-ext": "^10.8.0",
      "wxt": "^0.21.5"
   }
}
