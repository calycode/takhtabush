{
   "extends": "../../tsconfig.base.json",
   "compilerOptions": {
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "jsx": "react-jsx",
      "jsxImportSource": "preact",
      "types": ["node"],
      "baseUrl": ".",
      "paths": {
         "react": ["./node_modules/preact/compat/"],
         "react-dom": ["./node_modules/preact/compat/"]
      }
   },
   "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
